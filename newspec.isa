MX/11

REGS
A: 0x0    SA: 0x8
X: 0x1    SX: 0x9
Y: 0x2    SY: 0xA
D: 0x3    SD: 0xB

MBR: 0x4
DAR: 0x5
INSP: 0x6
FLAGS: 0x7

R0: 0xC
R1: 0xD
R2: 0xE
R3: 0xF

NOP:
00000000: alias MOV A, A

MOV
Base: 0dddssss

ddd -> rrr
ssss -> rrrr

| ddd | REGS | ssss |
| --- | ---- | ---- |
| 000 |    A | 0000 |
| 001 |    X | 0001 |
| 010 |    Y | 0010 |
| 011 |    D | 0011 |
|  x  |  DAR | 0100 |
|  x  |  MBR | 0101 |
|  x  | INSP | 0110 |
|  x  | FLAG | 0111 |
| 100 |   SA | 1000 |
| 101 |   SX | 1001 |
| 110 |   SY | 1010 |
| 111 |   SD | 1011 |
|  x  |   R0 | 1100 |
|  x  |   R1 | 1101 |
|  x  |   R2 | 1110 |
|  x  |   R3 | 1111 |

MOV r, r is MOV MBR, r

ALU Unary
Base: 100oosss

oo -> 00 (CLR)
      01 (INCR)
      10 (DECR)
      11 (NOT)

sss -> rrr

| sss | REGS |
| --- | ---- |
| 000 |    A |
| 001 |    X |
| 010 |    Y |
| 011 |    D |
| 100 |   SA |
| 101 |   SX |
| 110 |   SY |
| 111 |   SD |

Branch Group
Base: 101oosss

oo -> 00: INSP <- REGS[sss] if Z flag is set
      01: INSP <- INSP + REGS[sss] if Z flag is set
      10: INSP <- REGS[sss] if C flag is set
      11: INSP <- INSP + REGS[sss] if C flag is set

| sss | REGS |
| --- | ---- |
| 000 |    A |
| 001 |    X |
| 010 |    Y |
| 011 |    D |
| 100 |   SA |
| 101 |   SX |
| 110 |   SY |
| 111 |   SD |

ALU Binary
Base: 110ooopp

pp -> 00 X, Y
      01 A, X
      10 A, Y
      11 A, D

ooo -> 000 (ADD)
       001 (ADC)
       010 (SUB)
       011 (SBC)
       100 (AND)
       101 (OR)
       110 (XOR)
       111 (CMP)

LDI Group
Base: 1110iiii

iiii -> immediate value u4

SYS Group
Base: 1111oooo

| oooo | Description                               |
| ---- | ----------------------------------------- |
| 0000 | DSEL: DAR <- A                            |
| 0001 | DNXT: DAR <- DAR + 1                      |
| 0010 | DPRV: DAR <- DAR - 1                      |
| 0011 | DRET: DAR <- 0                            |
| 0100 | CTXS: Sr <- r, set CTX Flag               |
| 0101 | CRET: r <- Sr, clear CTX Flag             |
| 0110 | IRQ: Trigger IRQ, set I flag              |
| 0111 | RTI: Return from Interrupt, clear I flag  |
| 1000 | BRZ: INSP <- D if Z, RTA <- INSP          |
| 1001 | RET: INSP <- RTA                          |
| 1010 | SFA: FLAG <- FLAG OR A                    |
| 1011 | LFA: FLAG <- A                            |
| 1100 | LD: MBR <- [D]                            |
| 1101 | ST: [D] <- MBR                            |
| 1110 | NMI: Soft NMI                             |
| 1111 | HALT                                      |


+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| MOV | 0x0         | 0x1         | 0x2         | 0x3         | 0x4         | 0x5         | 0x6         | 0x7         | 0x8         | 0x9         | 0xA         | 0xB         | 0xC         | 0xD         | 0xE         | 0xF         |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x0 | NOP         | MOV A,X     | MOV A,Y     | MOV A,D     | MOV A,DAR   | MOV A,MBR   | MOV A,INSP  | MOV A,FLAGS | MOV A,SA    | MOV A,SX    | MOV A,SY    | MOV A,SD    | MOV A,R0    | MOV A,R1    | MOV A,R2    | MOV A,R3    |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x1 | MOV X,A     | MOV MBR,X   | MOV X,Y     | MOV X,D     | MOV X,DAR   | MOV X,MBR   | MOV X,INSP  | MOV X,FLAGS | MOV X,SA    | MOV X,SX    | MOV X,SY    | MOV X,SD    | MOV X,R0    | MOV X,R1    | MOV X,R2    | MOV X,R3    |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x2 | MOV Y,A     | MOV Y,X     | MOV MBR,Y   | MOV Y,D     | MOV Y,DAR   | MOV Y,MBR   | MOV Y,INSP  | MOV Y,FLAGS | MOV Y,SA    | MOV Y,SX    | MOV Y,SY    | MOV Y,SD    | MOV Y,R0    | MOV Y,R1    | MOV Y,R2    | MOV Y,R3    |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x3 | MOV D,A     | MOV D,X     | MOV D,Y     | MOV MBR,D   | MOV D,DAR   | MOV D,MBR   | MOV D,INSP  | MOV D,FLAGS | MOV D,SA    | MOV D,SX    | MOV D,SY    | MOV D,SD    | MOV D,R0    | MOV D,R1    | MOV D,R2    | MOV D,R3    |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x4 | MOV SA,A    | MOV SA,X    | MOV SA,Y    | MOV SA,D    | MOV SA,DAR  | MOV SA,MBR  | MOV SA,INSP | MOV SA,FLAGS| MOV MBR,SA  | MOV SA,SX   | MOV SA,SY   | MOV SA,SD   | MOV SA,R0   | MOV SA,R1   | MOV SA,R2   | MOV SA,R3   |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x5 | MOV SX,A    | MOV SX,X    | MOV SX,Y    | MOV SX,D    | MOV SX,DAR  | MOV MBR,SX  | MOV SX,INSP | MOV SX,FLAGS| MOV SX,SA   | MOV MBR,SX  | MOV SX,SY   | MOV SX,SD   | MOV SX,R0   | MOV SX,R1   | MOV SX,R2   | MOV SX,R3   |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x6 | MOV SY,A    | MOV SY,X    | MOV SY,Y    | MOV SY,D    | MOV SY,DAR  | MOV SY,MBR  | MOV MBR,SY  | MOV SY,FLAGS| MOV SY,SA   | MOV SY,SX   | MOV MBR,SY  | MOV SY,SD   | MOV SY,R0   | MOV SY,R1   | MOV SY,R2   | MOV SY,R3   |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x7 | MOV SD,A    | MOV SD,X    | MOV SD,Y    | MOV SD,D    | MOV SD,DAR  | MOV SD,MBR  | MOV SD,INSP | MOV MBR,SD  | MOV SD,SA   | MOV SD,SX   | MOV SD,SY   | MOV MBR,SD  | MOV SD,R0   | MOV SD,R1   | MOV SD,R2   | MOV SD,R3   |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+

+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| ALU | 0x0/0x8     | 0x1/0x9     | 0x2/0xA     | 0x3/0xB     | 0x4/0xC     | 0x5/0xD     | 0x6/0xE     | 0x7/0xF     |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x8 | CLR A       | CLR X       | CLR Y       | CLR D       | CLR SA      | CLR SX      | CLR SY      | CLR SD      |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x8 | INCR A      | INCR X      | INCR Y      | INCR D      | INCR SA     | INCR SX     | INCR SY     | INCR SD     |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x9 | DECR A      | DECR X      | DECR Y      | DECR D      | DECR SA     | DECR SX     | DECR SY     | DECR SD     |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0x9 | NOT A       | NOT X       | NOT Y       | NOT D       | NOT SA      | NOT SX      | NOT SY      | NOT SD      |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+

+-----+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+------------+------------+------------+------------+-------------+-------------+-------------+-------------+
| AOU | 0x0                        | 0x1                        | 0x2                        | 0x3                        | 0x4                        | 0x5                        | 0x6                        | 0x7                        | 0x8        | 0x9        | 0xA        | 0xB        | 0xC         | 0xD         | 0xE         | 0xF         |
+-----+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+------------+------------+------------+------------+-------------+-------------+-------------+-------------+
| 0x8 | CLR A                      | CLR X                      | CLR Y                      | CLR D                      | CLR SA                     | CLR SX                     | CLR SY                     | CLR SD                     | BZ A       | BZ X       | BZ Y       | BZ D       | BZ SA       | BZ SX       | BZ SY       | BZ SD       |
+-----+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+------------+------------+------------+------------+-------------+-------------+-------------+-------------+
| 0x9 | INCR A                     | INCR X                     | INCR Y                     | INCR D                     | INCR SA                    | INCR SX                    | INCR SY                    | INCR SD                    | BZ INSP, A | BZ INSP, X | BZ INSP, Y | BZ INSP, D | BZ INSP, SA | BZ INSP, SX | BZ INSP, SY | BZ INSP, SD |
+-----+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+------------+------------+------------+------------+-------------+-------------+-------------+-------------+
| 0xA | DECR A                     | DECR X                     | DECR Y                     | DECR D                     | DECR SA                    | DECR SX                    | DECR SY                    | DECR SD                    | BC A       | BC X       | BC Y       | BC D       | BC SA       | BC SX       | BC SY       | BC SD       |
+-----+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+------------+------------+------------+------------+-------------+-------------+-------------+-------------+
| 0xB | NOT A                      | NOT X                      | NOT Y                      | NOT D                      | NOT SA                     | NOT SX                     | NOT SY                     | NOT SD                     | BC INSP, A | BC INSP, X | BC INSP, Y | BC INSP, D | BC INSP, SA | BC INSP, SX | BC INSP, SY | BC INSP, SD |
+-----+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+----------------------------+------------+------------+------------+------------+-------------+-------------+-------------+-------------+

+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| AOB | 0x0         | 0x1         | 0x2         | 0x3         | 0x4         | 0x5         | 0x6         | 0x7         | 0x8         | 0x9         | 0xA         | 0xB         | 0xC         | 0xD         | 0xE         | 0xF         |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0xC | ADD X,Y     | ADD A,X     | ADD A,Y     | ADD A,D     | ADC X,Y     | ADC A,X     | ADC A,Y     | ADC A,D     | SUB X,Y     | SUB A,X     | SUB A,Y     | SUB A,D     | SBC X,Y     | SBC A,X     | SBC A,Y     | SBC A,D     |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0xD | AND X,Y     | AND A,X     | AND A,Y     | AND A,D     | OR X,Y      | OR A,X      | OR A,Y      | OR A,D      | XOR X,Y     | XOR A,X     | XOR A,Y     | XOR A,D     | CMP X,Y     | CMP A,X     | CMP A,Y     | CMP A,D     |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+

+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| LDI | 0x0         | 0x1         | 0x2         | 0x3         | 0x4         | 0x5         | 0x6         | 0x7         | 0x8         | 0x9         | 0xA         | 0xB         | 0xC         | 0xD         | 0xE         | 0xF         |
+-----+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+-------------+
| 0xE | LDI 0x0     | LDI 0x1     | LDI 0x2     | LDI 0x3     | LDI 0x4     | LDI 0x5     | LDI 0x6     | LDI 0x7     | LDI 0x8     | LDI 0x9     | LDI 0xA     | LDI 0xB     | LDI 0xC     | LDI 0xD     | LDI 0xE     | LDI 0xF     |
